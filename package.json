{
  "name": "aliexpress-parcel-intel",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.interceptor.config.ts && vite build -c vite.sw.config.ts && vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "preview:dashboard": "vite --config vite.dashboard-preview.config.ts",
    "build:interceptor": "vite build -c vite.interceptor.config.ts",
    "build:sw": "vite build -c vite.sw.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "world-atlas": "^2.0.2"
  },
  "description": "Chrome extension: your own AliExpress parcels on a map, with delivery estimates learned from your own history. All data stays in your browser.",
  "license": "MIT"
}
